* text=auto eol=lf

# Explicit binary types: git 1.9's text auto-detection misclassifies some of
# these (CRLF normalization would corrupt them and shows phantom modifications).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.wasm binary
